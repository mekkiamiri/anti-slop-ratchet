+package io.github.mekkiamiri.ratchet.order.application;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import io.github.mekkiamiri.ratchet.order.domain.OrderLine;
+import io.github.mekkiamiri.ratchet.order.infrastructure.InMemoryOrderRepository;
+import java.io.IOException;
+import java.math.BigDecimal;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Clock;
+import java.time.Instant;
+import java.time.ZoneOffset;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+class OrderExportServiceTest {
+
+    @TempDir
+    Path dir;
+
+    @Test
+    void writesOneLinePerOrderAfterTheHeader() throws IOException {
+        InMemoryOrderRepository repository = new InMemoryOrderRepository();
+        OrderService orders = new OrderService(repository, Clock.fixed(Instant.parse("2026-01-01T10:00:00Z"), ZoneOffset.UTC));
+        orders.create("ada", List.of(new OrderLine("CAFE", 2, new BigDecimal("1.50"))));
+        orders.create("=SUM(A1)", List.of(new OrderLine("THE", 1, new BigDecimal("2.00"))));
+        orders.create("Doe, \"Jane\"", List.of());
+        Path file = dir.resolve("orders.csv");
+
+        OrderExportService.Result result = new OrderExportService(repository, file).export();
+
+        assertThat(result.orders()).isEqualTo(3);
+        List<String> lines = Files.readAllLines(file);
+        assertThat(lines).hasSize(4);
+        assertThat(lines.get(0)).isEqualTo(OrderExportService.HEADER);
+        assertThat(lines).anyMatch(l -> l.contains(",ada,DRAFT,2026-01-01T10:00:00Z,1,3.00"));
+        assertThat(lines).anyMatch(l -> l.contains(",'=SUM(A1),DRAFT,"));
+        assertThat(lines).anyMatch(l -> l.contains(",\"Doe, \"\"Jane\"\"\",DRAFT,2026-01-01T10:00:00Z,0,0"));
+    }
+
+    @Test
+    void anExportWithoutOrdersWritesOnlyTheHeaderAndReplacesThePreviousFile() throws IOException {
+        Path file = dir.resolve("orders.csv");
+        Files.writeString(file, "ancien contenu");
+
+        new OrderExportService(new InMemoryOrderRepository(), file).export();
+
+        assertThat(Files.readAllLines(file)).containsExactly(OrderExportService.HEADER);
+    }
+}
