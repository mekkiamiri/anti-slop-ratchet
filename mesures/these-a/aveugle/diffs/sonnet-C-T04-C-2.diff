+package io.github.mekkiamiri.ratchet.order.application;
+
+import io.github.mekkiamiri.ratchet.order.domain.Order;
+import io.github.mekkiamiri.ratchet.order.domain.OrderRepository;
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Comparator;
+import java.util.List;
+import java.util.stream.Collectors;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.stereotype.Service;
+
+/** Exporte toutes les commandes en CSV : une ligne par commande, le fichier est réécrit à chaque export. */
+@Service
+public class OrderExportService {
+
+    private static final Logger LOG = LoggerFactory.getLogger(OrderExportService.class);
+
+    static final String HEADER = "id,customer,status,createdAt,lines,total";
+
+    /** Un tableur interprète une cellule qui commence par ces caractères comme une formule. */
+    private static final String FORMULA_PREFIXES = "=+-@\t\r";
+
+    public record Result(Path file, int orders) {
+    }
+
+    private final OrderRepository orders;
+    private final Path file;
+
+    public OrderExportService(OrderRepository orders, @Value("${orders.export.path:orders.csv}") Path file) {
+        this.orders = orders;
+        this.file = file;
+    }
+
+    public synchronized Result export() {
+        List<Order> all = orders.findAll().stream()
+                .sorted(Comparator.comparing(Order::createdAt).thenComparing(o -> o.id().value()))
+                .toList();
+        String csv = HEADER + "\r\n" + all.stream().map(OrderExportService::row)
+                .map(line -> line + "\r\n").collect(Collectors.joining());
+        try {
+            Files.writeString(file, csv, StandardCharsets.UTF_8);
+        } catch (IOException e) {
+            throw new UncheckedIOException("Écriture de l'export impossible : " + file, e);
+        }
+        LOG.info("{} commandes exportées vers {}", all.size(), file);
+        return new Result(file, all.size());
+    }
+
+    private static String row(Order order) {
+        return String.join(",",
+                cell(order.id().value()),
+                cell(order.customer()),
+                cell(order.status().name()),
+                cell(order.createdAt().toString()),
+                cell(String.valueOf(order.lines().size())),
+                cell(order.total().toPlainString()));
+    }
+
+    private static String cell(String value) {
+        String safe = !value.isEmpty() && FORMULA_PREFIXES.indexOf(value.charAt(0)) >= 0 ? "'" + value : value;
+        if (safe.indexOf(',') < 0 && safe.indexOf('"') < 0 && safe.indexOf('\n') < 0 && safe.indexOf('\r') < 0) {
+            return safe;
+        }
+        return '"' + safe.replace("\"", "\"\"") + '"';
+    }
+}
