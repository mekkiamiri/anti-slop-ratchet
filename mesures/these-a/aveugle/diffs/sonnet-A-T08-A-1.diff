+    /** Atomique par commande (retrait et archivage dans le même compute), pas sur l'ensemble du lot. */
+    @Override
+    public int archiveCreatedBefore(Instant cutoff) {
+        int archived = 0;
+        for (OrderId id : orders.keySet()) {
+            boolean[] moved = new boolean[1];
+            orders.computeIfPresent(id, (key, stored) -> {
+                if (!stored.createdAt().isBefore(cutoff)) {
+                    return stored;
+                }
+                archive.put(key, stored);
+                moved[0] = true;
+                return null;
+            });
+            if (moved[0]) {
+                archived++;
+            }
+        }
+        return archived;
+    }
 }
