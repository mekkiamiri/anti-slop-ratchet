+    /** Verrou de l'archivage : il exclut les écritures le temps du déplacement, pour qu'il soit atomique. */
+    private final Object writeLock = new Object();
+
     @Override
     public Order save(Order order) {
-        Order saved = orders.compute(order.id(), (id, stored) -> {
-            long current = stored == null ? 0 : stored.version();
-            if (current != order.version()) {
-                throw new ConcurrentOrderUpdateException(id, order.version(), current);
-            }
-            return order.copyAtVersion(current + 1);
-        });
-        return saved.copyAtVersion(saved.version());
+        synchronized (writeLock) {
+            Order saved = orders.compute(order.id(), (id, stored) -> {
+                long current = stored == null ? 0 : stored.version();
+                if (current != order.version()) {
+                    throw new ConcurrentOrderUpdateException(id, order.version(), current);
+                }
+                return order.copyAtVersion(current + 1);
+            });
+            return saved.copyAtVersion(saved.version());
+        }
+    }
+
+    @Override
+    public int archiveCreatedBefore(Instant cutoff) {
+        synchronized (writeLock) {
+            // Copie d'abord dans l'archive, retire ensuite : une commande n'est jamais absente des deux.
+            List<Order> old = orders.values().stream().filter(o -> o.createdAt().isBefore(cutoff)).toList();
+            old.forEach(o -> archive.put(o.id(), o));
+            old.forEach(o -> orders.remove(o.id()));
+            return old.size();
+        }
+    }
+
+    /** Commandes archivées, pour les tests : l'archive n'est pas encore exposée par l'API. */
+    boolean isArchived(OrderId id) {
+        return archive.containsKey(id);
     }
 }
