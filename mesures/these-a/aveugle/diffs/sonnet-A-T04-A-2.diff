+package io.github.mekkiamiri.ratchet.order.application;
+
+import io.github.mekkiamiri.ratchet.order.domain.Order;
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.util.List;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.stereotype.Component;
+
+/**
+ * Écrit les commandes en CSV (RFC 4180), une ligne par commande après l'en-tête.
+ *
+ * <p>Le fichier est écrit dans un temporaire puis déplacé : un lecteur ne voit jamais un fichier
+ * à moitié écrit. Les champs commençant par {@code = + - @} sont préfixés d'une apostrophe, pour
+ * que le nom du client ne soit pas interprété comme une formule par un tableur.
+ */
+@Component
+public class OrderCsvExporter {
+
+    static final String HEADER = "id,customer,createdAt,status,lineCount,total";
+
+    public record Result(Path file, int count) {}
+
+    private final Path file;
+
+    public OrderCsvExporter(@Value("${orders.export.path:orders.csv}") Path file) {
+        this.file = file;
+    }
+
+    public Result export(List<Order> orders) {
+        StringBuilder csv = new StringBuilder(HEADER).append("\r\n");
+        for (Order o : orders) {
+            csv.append(field(o.id().value())).append(',')
+                    .append(field(o.customer())).append(',')
+                    .append(o.createdAt()).append(',')
+                    .append(o.status()).append(',')
+                    .append(o.lines().size()).append(',')
+                    .append(o.total().toPlainString()).append("\r\n");
+        }
+        Path target = file.toAbsolutePath();
+        try {
+            Path tmp = Files.createTempFile(target.getParent(), "orders", ".tmp");
+            try {
+                Files.writeString(tmp, csv, StandardCharsets.UTF_8);
+                Files.move(tmp, target, StandardCopyOption.REPLACE_EXISTING);
+            } finally {
+                Files.deleteIfExists(tmp);
+            }
+            return new Result(target, orders.size());
+        } catch (IOException e) {
+            throw new UncheckedIOException("Export CSV impossible vers " + target, e);
+        }
+    }
+
+    static String field(String value) {
+        String safe = !value.isEmpty() && "=+-@\t\r".indexOf(value.charAt(0)) >= 0 ? "'" + value : value;
+        if (safe.contains(",") || safe.contains("\"") || safe.contains("\n") || safe.contains("\r")) {
+            return '"' + safe.replace("\"", "\"\"") + '"';
+        }
+        return safe;
+    }
+}
