+    @Override
+    public int archiveCreatedBefore(Instant cutoff) {
+        int count = 0;
+        for (Order stored : orders.values()) {
+            if (!stored.createdAt().isBefore(cutoff)) {
+                continue;
+            }
+            archived.put(stored.id(), stored);
+            // remove(clé, valeur) échoue si la commande a été réécrite entre-temps : on annule alors la copie.
+            if (orders.remove(stored.id(), stored)) {
+                count++;
+            } else {
+                archived.remove(stored.id(), stored);
+            }
+        }
+        return count;
+    }
 }
