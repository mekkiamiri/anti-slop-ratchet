+package io.github.mekkiamiri.ratchet.order.application;
+
+import io.github.mekkiamiri.ratchet.order.domain.Order;
+import io.github.mekkiamiri.ratchet.order.domain.OrderRepository;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.stereotype.Service;
+
+/** Export des commandes en CSV : un en-tête, puis une ligne par commande. */
+@Service
+public class OrderCsvExporter {
+
+    private static final Logger LOG = LoggerFactory.getLogger(OrderCsvExporter.class);
+
+    static final String HEADER = "id,customer,status,createdAt,lines,total";
+
+    private final OrderRepository orders;
+    private final Path path;
+
+    public OrderCsvExporter(OrderRepository orders, @Value("${orders.export.path:orders.csv}") Path path) {
+        this.orders = orders;
+        this.path = path;
+    }
+
+    public Path path() {
+        return path;
+    }
+
+    /** Réécrit le fichier en entier et renvoie le nombre de commandes exportées. */
+    public int export() throws IOException {
+        List<Order> all = orders.findAll();
+        List<String> rows = new ArrayList<>();
+        rows.add(HEADER);
+        all.forEach(order -> rows.add(row(order)));
+        Files.write(path, rows, StandardCharsets.UTF_8);
+        LOG.info("{} commandes exportées dans {}", all.size(), path);
+        return all.size();
+    }
+
+    private static String row(Order order) {
+        return String.join(",",
+                escape(order.id().value()),
+                escape(order.customer()),
+                order.status().name(),
+                order.createdAt().toString(),
+                String.valueOf(order.lines().size()),
+                order.total().toPlainString());
+    }
+
+    /** Guillemets RFC 4180, et apostrophe devant =, +, -, @ pour éviter l'injection de formule. */
+    static String escape(String value) {
+        String safe = !value.isEmpty() && "=+-@\t\r".indexOf(value.charAt(0)) >= 0 ? "'" + value : value;
+        if (safe.contains(",") || safe.contains("\"") || safe.contains("\n") || safe.contains("\r")) {
+            return "\"" + safe.replace("\"", "\"\"") + "\"";
+        }
+        return safe;
+    }
+}
