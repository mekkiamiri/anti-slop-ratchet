+package io.github.mekkiamiri.ratchet.order.application;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import io.github.mekkiamiri.ratchet.order.domain.Order;
+import io.github.mekkiamiri.ratchet.order.domain.OrderId;
+import io.github.mekkiamiri.ratchet.order.domain.OrderLine;
+import io.github.mekkiamiri.ratchet.order.infrastructure.InMemoryOrderRepository;
+import java.io.IOException;
+import java.math.BigDecimal;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Instant;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+class OrderCsvExporterTest {
+
+    @TempDir
+    Path dir;
+
+    @Test
+    void writesAHeaderAndOneLinePerOrder() throws IOException {
+        InMemoryOrderRepository repository = new InMemoryOrderRepository();
+        Order first = new Order(OrderId.newId(), "ada", Instant.parse("2026-01-01T10:00:00Z"));
+        first.addLine(new OrderLine("CAFE", 2, new BigDecimal("1.50")));
+        Order second = new Order(OrderId.newId(), "=cmd, \"x\"", Instant.parse("2026-01-02T10:00:00Z"));
+        repository.save(first);
+        repository.save(second);
+        Path file = dir.resolve("orders.csv");
+
+        int count = new OrderCsvExporter(repository, file).export();
+
+        List<String> lines = Files.readAllLines(file);
+        assertThat(count).isEqualTo(2);
+        assertThat(lines).containsExactly(
+                "id,customer,status,createdAt,lines,total",
+                first.id().value() + ",ada,DRAFT,2026-01-01T10:00:00Z,1,3.00",
+                second.id().value() + ",\"'=cmd, \"\"x\"\"\",DRAFT,2026-01-02T10:00:00Z,0,0");
+    }
+}
