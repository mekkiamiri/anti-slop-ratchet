+package io.github.mekkiamiri.ratchet.order.web;
+
+import io.github.mekkiamiri.ratchet.order.application.OrderService.OrderStats;
+import java.math.BigDecimal;
+
+public record StatsResponse(long orderCount, BigDecimal totalRevenue) {
+
+    static StatsResponse from(OrderStats stats) {
+        return new StatsResponse(stats.orderCount(), stats.totalRevenue());
+    }
+}
