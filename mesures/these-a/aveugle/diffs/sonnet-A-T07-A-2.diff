+package io.github.mekkiamiri.ratchet.order.web;
+
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import io.github.mekkiamiri.ratchet.order.application.OrderService;
+import io.github.mekkiamiri.ratchet.order.domain.OrderLine;
+import java.math.BigDecimal;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.test.web.servlet.MockMvc;
+
+@SpringBootTest
+@AutoConfigureMockMvc
+class StatsControllerTest {
+
+    private final MockMvc mvc;
+    private final OrderService service;
+
+    @Autowired
+    StatsControllerTest(MockMvc mvc, OrderService service) {
+        this.mvc = mvc;
+        this.service = service;
+    }
+
+    @Test
+    void statsCountEveryOrderButOnlyConfirmedOnesAddToRevenue() throws Exception {
+        OrderService.OrderStats before = service.stats();
+        var line = new OrderLine("CAFE", 2, new BigDecimal("1.50"));
+
+        service.confirm(service.create("ada", List.of(line)).id());
+        service.cancel(service.create("bob", List.of(line)).id());
+        service.create("eve", List.of(line));
+
+        mvc.perform(get("/stats"))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.orderCount").value(before.orderCount() + 3))
+                .andExpect(jsonPath("$.totalRevenue").value(before.totalRevenue().add(new BigDecimal("3.00")).doubleValue()));
+    }
+}
