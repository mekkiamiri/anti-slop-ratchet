+package io.github.mekkiamiri.ratchet.order.application;
+
+import org.springframework.scheduling.annotation.Scheduled;
+import org.springframework.stereotype.Component;
+
+/** Tâche planifiée : archivage nocturne à 02h00 UTC, le fuseau de l'horloge de l'application. */
+@Component
+public class OrderArchiveJob {
+
+    private final OrderService service;
+
+    public OrderArchiveJob(OrderService service) {
+        this.service = service;
+    }
+
+    @Scheduled(cron = "0 0 2 * * *", zone = "UTC")
+    public void run() {
+        service.archiveOldOrders();
+    }
+}
