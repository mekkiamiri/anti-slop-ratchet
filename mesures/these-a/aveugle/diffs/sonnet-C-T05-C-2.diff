diff --git a/src/main/java/io/github/mekkiamiri/ratchet/order/domain/Order.java b/src/main/java/io/github/mekkiamiri/ratchet/order/domain/Order.java
index 3ccc68d..a227743 100644
--- a/src/main/java/io/github/mekkiamiri/ratchet/order/domain/Order.java
+++ b/src/main/java/io/github/mekkiamiri/ratchet/order/domain/Order.java
@@ -57,10 +57,20 @@ public class Order {
         status = OrderStatus.CONFIRMED;
     }
 
+    public void ship() {
+        if (status != OrderStatus.CONFIRMED) {
+            throw new InvalidOrderException("Seule une commande confirmée peut être expédiée, or elle est " + status);
+        }
+        status = OrderStatus.SHIPPED;
+    }
+
     public void cancel() {
         if (status == OrderStatus.CANCELLED) {
             throw new InvalidOrderException("Commande déjà annulée");
         }
+        if (status == OrderStatus.SHIPPED) {
+            throw new InvalidOrderException("Une commande expédiée ne peut pas être annulée");
+        }
         status = OrderStatus.CANCELLED;
     }
 
