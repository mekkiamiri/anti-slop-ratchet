+package io.github.mekkiamiri.ratchet.order.application;
+
+import java.util.List;
+import java.util.concurrent.CopyOnWriteArrayList;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.stereotype.Service;
+
+/** Envoi de notifications simulé : les messages ne partent nulle part, ils sont seulement gardés en liste. */
+@Service
+public class NotificationService {
+
+    private static final Logger LOG = LoggerFactory.getLogger(NotificationService.class);
+
+    private final List<String> sent = new CopyOnWriteArrayList<>();
+
+    public void send(String recipient, String message) {
+        sent.add(message);
+        LOG.info("Notification pour {} : {}", recipient, message);
+    }
+
+    /** Les messages envoyés, dans l'ordre d'envoi. */
+    public List<String> sentMessages() {
+        return List.copyOf(sent);
+    }
+}
