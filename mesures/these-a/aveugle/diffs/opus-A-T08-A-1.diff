+
+    /**
+     * Le déplacement de chaque commande se fait dans {@code computeIfPresent}, qui verrouille son entrée :
+     * aucun {@link #save} ne peut s'intercaler. Une fois retirée, une copie lue auparavant (version ≥ 1)
+     * est refusée par {@link #save} car l'entrée absente vaut la version 0.
+     */
+    @Override
+    public int archiveCreatedBefore(Instant cutoff) {
+        List<OrderId> candidates = orders.values().stream()
+                .filter(order -> order.createdAt().isBefore(cutoff))
+                .map(Order::id)
+                .toList();
+        int archived = 0;
+        for (OrderId candidate : candidates) {
+            boolean[] moved = {false};
+            orders.computeIfPresent(candidate, (id, stored) -> {
+                if (!stored.createdAt().isBefore(cutoff)) {
+                    return stored;
+                }
+                archive.put(id, stored);
+                moved[0] = true;
+                return null;
+            });
+            if (moved[0]) {
+                archived++;
+            }
+        }
+        return archived;
+    }
+
+    @Override
+    public Optional<Order> findArchivedById(OrderId id) {
+        return Optional.ofNullable(archive.get(id)).map(stored -> stored.copyAtVersion(stored.version()));
+    }
 }
