+package io.github.mekkiamiri.ratchet.order.application;
+
+import org.springframework.scheduling.annotation.Scheduled;
+import org.springframework.stereotype.Component;
+
+/**
+ * Déclenche chaque nuit l'archivage des commandes anciennes.
+ *
+ * <p>Classe séparée du service : l'appel passe par le bean {@link OrderService}, donc par son proxy
+ * Spring. Un {@code @Scheduled} qui appellerait une méthode de sa propre classe contournerait le proxy,
+ * et un éventuel {@code @Transactional} serait ignoré.
+ */
+@Component
+public class OrderArchivingJob {
+
+    private final OrderService orderService;
+
+    public OrderArchivingJob(OrderService orderService) {
+        this.orderService = orderService;
+    }
+
+    /** Par défaut à 3 h (UTC) ; réglable par {@code orders.archiving.cron}. */
+    @Scheduled(cron = "${orders.archiving.cron:0 0 3 * * *}", zone = "UTC")
+    public void archiveOldOrders() {
+        orderService.archiveOldOrders();
+    }
+}
