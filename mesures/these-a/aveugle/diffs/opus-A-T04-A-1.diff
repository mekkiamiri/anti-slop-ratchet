@@ -0,0 +1,85 @@
+package io.github.mekkiamiri.ratchet.order.infrastructure;
+
+import io.github.mekkiamiri.ratchet.order.domain.Order;
+import io.github.mekkiamiri.ratchet.order.domain.OrderExporter;
+import java.io.BufferedWriter;
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.util.List;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.stereotype.Component;
+
+/**
+ * Écrit les commandes dans un fichier CSV (RFC 4180, UTF-8), une ligne par commande.
+ *
+ * <p>Le fichier est d'abord écrit à côté puis renommé : un lecteur ne voit jamais un export à
+ * moitié écrit, et deux exports simultanés ne mélangent pas leurs lignes.
+ */
+@Component
+public class CsvOrderExporter implements OrderExporter {
+
+    static final String HEADER = "id,customer,status,createdAt,lineCount,total";
+
+    private final Path configured;
+    private final Path target;
+
+    public CsvOrderExporter(@Value("${orders.export.path:orders.csv}") Path target) {
+        this.configured = target;
+        this.target = target.toAbsolutePath();
+    }
+
+    @Override
+    public String export(List<Order> orders) {
+        Path tmp = null;
+        try {
+            Files.createDirectories(target.getParent());
+            tmp = Files.createTempFile(target.getParent(), target.getFileName().toString(), ".tmp");
+            try (BufferedWriter out = Files.newBufferedWriter(tmp, StandardCharsets.UTF_8)) {
+                out.write(HEADER);
+                out.write("\r\n");
+                for (Order order : orders) {
+                    out.write(toRow(order));
+                    out.write("\r\n");
+                }
+            }
+            Files.move(tmp, target, StandardCopyOption.REPLACE_EXISTING, StandardCopyOption.ATOMIC_MOVE);
+            // Le chemin tel que configuré : pas besoin d'exposer l'arborescence du serveur au client HTTP.
+            return configured.toString();
+        } catch (IOException e) {
+            deleteQuietly(tmp);
+            throw new UncheckedIOException("Export CSV impossible vers " + target, e);
+        }
+    }
+
+    static String toRow(Order order) {
+        return String.join(",",
+                escape(order.id().value()),
+                escape(order.customer()),
+                order.status().name(),
+                order.createdAt().toString(),
+                Integer.toString(order.lines().size()),
+                order.total().toPlainString());
+    }
+
+    static String escape(String value) {
+        if (value.contains(",") || value.contains("\"") || value.contains("\n") || value.contains("\r")) {
+            return "\"" + value.replace("\"", "\"\"") + "\"";
+        }
+        return value;
+    }
+
+    private static void deleteQuietly(Path tmp) {
+        if (tmp == null) {
+            return;
+        }
+        try {
+            Files.deleteIfExists(tmp);
+        } catch (IOException ignored) {
+            // Le fichier temporaire restera : l'erreur d'origine est plus utile que celle-ci.
+        }
+    }
+}
