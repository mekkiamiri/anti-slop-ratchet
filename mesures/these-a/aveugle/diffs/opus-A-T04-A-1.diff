+package io.github.mekkiamiri.ratchet.order.infrastructure;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import io.github.mekkiamiri.ratchet.order.domain.Order;
+import io.github.mekkiamiri.ratchet.order.domain.OrderId;
+import io.github.mekkiamiri.ratchet.order.domain.OrderLine;
+import java.math.BigDecimal;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Instant;
+import java.util.List;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+class CsvOrderExporterTest {
+
+    @TempDir
+    Path dir;
+
+    @Test
+    void writesOneRowPerOrderAfterTheHeader() throws Exception {
+        Order draft = new Order(new OrderId("o-1"), "ada", Instant.parse("2027-04-14T09:00:00Z"));
+        draft.addLine(new OrderLine("CAFE", 2, new BigDecimal("1.50")));
+        draft.addLine(new OrderLine("THE", 1, new BigDecimal("2.25")));
+        Order confirmed = new Order(new OrderId("o-2"), "bob", Instant.parse("2027-04-14T10:00:00Z"));
+        confirmed.addLine(new OrderLine("CAFE", 1, BigDecimal.ONE));
+        confirmed.confirm();
+        Path file = dir.resolve("orders.csv");
+
+        String location = new CsvOrderExporter(file).export(List.of(draft, confirmed));
+
+        assertThat(location).isEqualTo(file.toString());
+        assertThat(Files.readString(file, StandardCharsets.UTF_8)).isEqualTo(
+                "id,customer,status,createdAt,lineCount,total\r\n"
+                        + "o-1,ada,DRAFT,2027-04-14T09:00:00Z,2,5.25\r\n"
+                        + "o-2,bob,CONFIRMED,2027-04-14T10:00:00Z,1,1\r\n");
+    }
+
+    @Test
+    void escapesCustomersThatWouldBreakTheCsv() throws Exception {
+        Order order = new Order(new OrderId("o-1"), "Dupont, \"SARL\"\nÉté", Instant.parse("2027-04-14T09:00:00Z"));
+        Path file = dir.resolve("orders.csv");
+
+        new CsvOrderExporter(file).export(List.of(order));
+
+        assertThat(Files.readAllLines(file, StandardCharsets.UTF_8).get(0))
+                .isEqualTo(CsvOrderExporter.HEADER);
+        assertThat(Files.readString(file, StandardCharsets.UTF_8))
+                .contains("o-1,\"Dupont, \"\"SARL\"\"\nÉté\",DRAFT,2027-04-14T09:00:00Z,0,0\r\n");
+    }
+
+    @Test
+    void replacesThePreviousExportAndLeavesNoTemporaryFile() throws Exception {
+        Path file = dir.resolve("sub/orders.csv");
+        CsvOrderExporter exporter = new CsvOrderExporter(file);
+        exporter.export(List.of(new Order(new OrderId("ancienne"), "ada", Instant.EPOCH)));
+
+        exporter.export(List.of());
+
+        assertThat(Files.readString(file)).isEqualTo(CsvOrderExporter.HEADER + "\r\n");
+        try (var files = Files.list(file.getParent())) {
+            assertThat(files).containsExactly(file);
+        }
+    }
+}
