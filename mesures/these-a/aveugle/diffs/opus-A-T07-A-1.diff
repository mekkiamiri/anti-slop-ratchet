+    /** Seules les commandes confirmées comptent : un brouillon ou une annulation n'est pas une vente. */
+    public OrderStats stats() {
+        List<Order> confirmed = orders.findAll().stream()
+                .filter(order -> order.status() == OrderStatus.CONFIRMED)
