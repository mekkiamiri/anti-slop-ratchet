+package io.github.mekkiamiri.ratchet.order.web;
+
+import io.github.mekkiamiri.ratchet.order.application.OrderService;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+/** Statistiques globales sur les commandes. */
+@RestController
+public class StatsController {
+
+    private final OrderService service;
+
+    public StatsController(OrderService service) {
+        this.service = service;
+    }
+
+    @GetMapping("/stats")
+    public StatsResponse stats() {
+        return StatsResponse.from(service.stats());
+    }
+}
