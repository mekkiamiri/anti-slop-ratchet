+    /** Remise de 10 % quand le sous-total dépasse strictement 100 €, arrondie au centime. */
+    public BigDecimal discount() {
+        BigDecimal subtotal = subtotal();
+        if (subtotal.compareTo(DISCOUNT_THRESHOLD) <= 0) {
+            return BigDecimal.ZERO;
+        }
+        return subtotal.multiply(DISCOUNT_RATE).setScale(2, RoundingMode.HALF_UP);
+    }
+
+    /** Total à payer : sous-total moins la remise. */
