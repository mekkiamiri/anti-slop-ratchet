+package io.github.mekkiamiri.ratchet.order.domain;
+
+/** Port du domaine : l'envoi des notifications est un détail d'infrastructure. */
+public interface OrderNotifier {
+
+    /** Prévient le client que sa commande, déjà enregistrée, est confirmée. */
+    void orderConfirmed(Order order);
+}
