@@ -0,0 +1,32 @@
+package io.github.mekkiamiri.ratchet.order.infrastructure;
+
+import io.github.mekkiamiri.ratchet.order.domain.Order;
+import io.github.mekkiamiri.ratchet.order.domain.OrderNotifier;
+import java.util.List;
+import java.util.concurrent.CopyOnWriteArrayList;
+import org.springframework.stereotype.Component;
+
+/**
+ * Envoi simulé : garde la liste des messages au lieu de les envoyer. Remplaçable par un vrai
+ * canal (e-mail, SMS...) sans toucher au domaine.
+ */
+@Component
+public class InMemoryOrderNotifier implements OrderNotifier {
+
+    /** Message envoyé à un destinataire. */
+    public record SentMessage(String recipient, String text) {
+    }
+
+    private final List<SentMessage> sent = new CopyOnWriteArrayList<>();
+
+    @Override
+    public void orderConfirmed(Order order) {
+        sent.add(new SentMessage(order.customer(),
+                "Votre commande " + order.id().value() + " est confirmée (total : " + order.total() + ")"));
+    }
+
+    /** Messages envoyés, dans l'ordre d'envoi. */
+    public List<SentMessage> sentMessages() {
+        return List.copyOf(sent);
+    }
+}
