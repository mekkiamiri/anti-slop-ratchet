+package io.github.mekkiamiri.ratchet.order.domain;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+import org.junit.jupiter.api.Test;
+
+class OrderTotalTest {
+
+    private final Order order = new Order(new OrderId("o-1"), "ada", Instant.parse("2027-04-14T09:00:00Z"));
+
+    @Test
+    void emptyOrderTotalIsZero() {
+        assertThat(order.total()).isEqualByComparingTo("0");
+    }
+
+    @Test
+    void lineTotalIsUnitPriceTimesQuantity() {
+        assertThat(new OrderLine("CAFE", 4, new BigDecimal("2.50")).total()).isEqualByComparingTo("10.00");
+    }
+
+    @Test
+    void totalSumsAllLines() {
+        order.addLine(new OrderLine("CAFE", 2, new BigDecimal("1.25")));
+        order.addLine(new OrderLine("THE", 3, new BigDecimal("4.00")));
+
+        assertThat(order.total()).isEqualByComparingTo("14.50");
+    }
+
+    @Test
+    void freeLineContributesNothing() {
+        order.addLine(new OrderLine("CAFE", 2, new BigDecimal("1.50")));
+        order.addLine(new OrderLine("ECHANTILLON", 5, BigDecimal.ZERO));
+
+        assertThat(order.total()).isEqualByComparingTo("3.00");
+    }
+
+    @Test
+    void totalIsFreeOfFloatingPointErrors() {
+        for (int i = 0; i < 10; i++) {
+            order.addLine(new OrderLine("BONBON", 1, new BigDecimal("0.1")));
+        }
+
+        assertThat(order.total()).isEqualByComparingTo("1.0");
+    }
+
+    @Test
+    void totalIsUnchangedByConfirmation() {
+        order.addLine(new OrderLine("CAFE", 3, new BigDecimal("2.00")));
+        BigDecimal before = order.total();
+
+        order.confirm();
+
+        assertThat(order.total()).isEqualByComparingTo(before);
+    }
+
+    @Test
+    void copyKeepsTheSameTotal() {
+        order.addLine(new OrderLine("CAFE", 3, new BigDecimal("2.00")));
+
+        assertThat(order.copyAtVersion(1).total()).isEqualByComparingTo("6.00");
+    }
+}
