diff --git a/src/main/java/io/github/mekkiamiri/ratchet/order/domain/Order.java b/src/main/java/io/github/mekkiamiri/ratchet/order/domain/Order.java
index 3ccc68d..a089508 100644
--- a/src/main/java/io/github/mekkiamiri/ratchet/order/domain/Order.java
+++ b/src/main/java/io/github/mekkiamiri/ratchet/order/domain/Order.java
@@ -64,10 +64,30 @@ public class Order {
         status = OrderStatus.CANCELLED;
     }
 
+    /** Total des articles, hors frais de port. */
     public BigDecimal total() {
         return lines.stream().map(OrderLine::total).reduce(BigDecimal.ZERO, BigDecimal::add);
     }
 
+    /**
+     * Frais de port : 4,90 € si le total des articles est strictement inférieur à
+     * 50 €, offerts à partir de 50 €. Une commande sans ligne n'a rien à expédier, donc pas de frais.
+     */
+    public BigDecimal shippingFee() {
+        if (lines.isEmpty() || total().compareTo(FREE_SHIPPING_THRESHOLD) >= 0) {
+            return BigDecimal.ZERO;
+        }
+        return SHIPPING_FEE;
+    }
+
+    /** Montant à payer : total des articles plus frais de port. */
+    public BigDecimal totalWithShipping() {
+        return total().add(shippingFee());
+    }
+
+    private static final BigDecimal SHIPPING_FEE = new BigDecimal("4.90");
+    private static final BigDecimal FREE_SHIPPING_THRESHOLD = new BigDecimal("50.00");
+
     public OrderId id() {
         return id;
     }
