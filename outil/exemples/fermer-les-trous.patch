@@ -0,0 +1,23 @@
+package io.github.mekkiamiri.ratchet.rules;
+
+import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.noMethods;
+
+import com.tngtech.archunit.core.domain.JavaClasses;
+import com.tngtech.archunit.core.importer.ClassFileImporter;
+import com.tngtech.archunit.core.importer.ImportOption;
+import org.junit.jupiter.api.Disabled;
+import org.junit.jupiter.api.Test;
+
+/** Trou J23 trouvé par harness-mutant : un test désactivé reste vert. */
+class HarnessGapsArchTest {
+
+    @Test
+    void noTestIsDisabled() {
+        JavaClasses tests = new ClassFileImporter()
+                .withImportOption(ImportOption.Predefined.ONLY_INCLUDE_TESTS)
+                .importPackages("io.github.mekkiamiri.ratchet");
+        noMethods().should().beAnnotatedWith(Disabled.class)
+                .because("un test désactivé ne protège plus rien et le rapport reste vert")
+                .check(tests);
+    }
+}
